FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

# Image isolee pour AudioLDM 2 : diffusers 0.42 exige huggingface-hub < 1.0,
# incompatible avec celui de l'image Alexandria (2.4.0). Pas de transformers ici,
# donc aucun conflit.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "diffusers==0.42.1" soundfile accelerate librosa "transformers==4.46.3"

WORKDIR /work
